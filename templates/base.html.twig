<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Vite et Gourmand{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body>
        <nav class="navbar vg-navbar navbar-expand-lg" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Vite & Gourmand</a>
                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navigationPrincipale"
                    aria-controls="navigationPrincipale"
                    aria-expanded="false"
                    aria-label="Afficher ou masquer la navigation"
                >
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navigationPrincipale">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Accueil</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_menus') }}">Menus</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" href="#">Connexion</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        {% block body %}{% endblock %}
        <footer class="vg-footer">
            <div class="container py-4">
                <div class="row">
                    <div class="col-md text-center text-md-start mb-3 mb-md-0">
                        <h2 class="h6 fw-bold">Horaires</h2>
                        <ul class="list-unstyled mb-0">
                            <li>Lundi : fermé</li>
                            <li>Mardi : 9h00 – 18h00</li>
                            <li>Mercredi : 9h00 – 18h00</li>
                            <li>Jeudi : 9h00 – 18h00</li>
                            <li>Vendredi : 9h00 – 19h00</li>
                            <li>Samedi : 9h00 – 19h00</li>
                            <li>Dimanche : 10h00 – 14h00</li>
                        </ul>
                    </div>
                    {# col-md-auto : dès md (768 px), largeur du contenu, à droite ; en dessous, pleine largeur, sous les horaires  #}
                    <div class="col-md-auto text-center text-md-start">
                        <h2 class="h6 fw-bold">Informations</h2>
                        <ul class="list-unstyled mb-0">
                            <li><a href="#">Mentions légales</a></li>
                            <li><a href="#"><abbr title="Conditions générales de vente">CGV</abbr></a></li>
                            <li><a href="#">Contact</a></li>
                        </ul>
                    </div>
                </div>
                <p class="text-center small mt-4 mb-0">© 2026 Vite & Gourmand. Tous droits réservés.</p>
            </div>
        </footer>
    </body>
</html>
