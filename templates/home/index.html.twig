{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ parent() }}{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container-fluid vg-container">
            <div class="row align-items-center g-4">
                <div class="col-lg-6 text-center">
                    <p>Traiteur à Bordeaux depuis 25 ans</p>
                    <h1>Vos repas de fête, sans lever le petit doigt</h1>
                    <p>Nous, c'est Julie et José. On cuisine pour tous vos événements : Noël, Pâques ou simple repas en famille. Choisissez votre menu, on s'occupe du reste.</p>
                    <a class="btn btn-primary my-2" href="{{ path('app_menus') }}">Voir les menus</a>
                    <a class="btn btn-outline-dark" href="#equipe">Découvrir l'équipe</a>
                </div>
                <div class="col-lg-6">
                    {# valeurs W et H viennent de squoosh = garde les proportions d'origine  #}
                    <img src="{{ asset('images/accueil.webp') }}" alt="Deux personnes trinquent au-dessus d'une table dressée" width="1400" height="977" class="img-fluid rounded">
                </div>

            </div>


        </div>
    </section>

    <section class="py-5 bg-white">
        <div class="container-fluid vg-container">
            <h2 class="text-center mb-5">Ces clients qui nous veulent du bien</h2>
            <div class="row g-4">
                {% for avis in derniersAvis %}
                    <div class="col-md-4">
                        <div class="vg-avis p-3 rounded text-center h-100">
                            <p><span aria-hidden="true">{% for i in 1..5 %}{% if i <= avis.note %}★{% else %}☆{% endif %}{% endfor %}</span><span class="visually-hidden">Note : {{ avis.note }} sur 5</span></p>
                            
                            <blockquote>«&nbsp;{{ avis.description }}&nbsp;»</blockquote>
                            <p class="mb-0">{{ avis.commande.utilisateur.prenom }}  {% if avis.commande.utilisateur.nom %}{{ avis.commande.utilisateur.nom|first }}.{% endif %}</p>
               
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-center mb-0">Aucun avis pour le moment</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="equipe" class="py-5">
        <div class="container-fluid vg-container">
            <h2 class="text-center mb-4">Julie, José... et beaucoup de beurre</h2>
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    {# valeurs W et H viennent de squoosh = garde les proportions d'origine #}
                    <img src="{{ asset('images/equipe.webp') }}" alt="Cuisiniers en train de dresser des assiettes en cuisine" width="1400" height="933" class="img-fluid rounded">
                </div>
                <div class="col-lg-6 text-center">
                    <p>Depuis 25 ans, toute notre équipe met son savoir-faire au service de vos fêtes. Nous mettons en valeur les producteurs locaux : viande de la boucherie Dupère, fromages de la chèvrerie Lehamstel, légumes de la coopérative des maraîchers et jus de fruits bio de la ferme des Prunelles. Tout est frais, de saison et 0% surgelé. Et nous vous livrons avec soin dans toute la région bordelaise.</p>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="vg-chiffre p-3 h-100">
                                <p><span class="fs-3 fw-bold">25 ans</span><br>de fêtes</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="vg-chiffre p-3 h-100">
                                <p><span class="fs-3 fw-bold">100%</span><br>fait maison</p>
                            </div>
                        </div>
                    
                    </div>
                </div>
            </div>
           
        </div>
        
    </section>
{% endblock %}
