{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ parent() }}{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container-fluid vg-container">
            <div class="row align-items-center g-4">
                <div class="col-lg-6 text-center">
                    <p>Traiteur à Bordeaux depuis 25 ans</p>
                    <h1>Vos repas de fête, livrés chez vous</h1>
                    <p>Julie et José cuisinent pour tous vos événements : Noël, Pâques ou simple repas en famille. Choisissez votre menu, on s'occupe du reste.</p>
                    <a class="btn btn-primary my-2" href="{{ path('app_menus') }}">Voir les menus</a>
                    <a class="btn btn-outline-dark" href="#equipe">Découvrir l'équipe</a>
                </div>
                <div class="col-lg-6">
                    {# valeurs W et H viennent de squoosh = garde les proportions d'origine  #}
                    <img src="{{ asset('images/accueil.webp') }}" alt="Deux personnes trinquent au-dessus d'une table dressée" width="1400" height="977" class="img-fluid rounded">
                </div>

            </div>


        </div>
    </section>

    <section class="py-5 bg-white">
        <div class="container-fluid vg-container">
            <h2 class="text-center mb-5">Ils nous ont fait confiance</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="vg-avis p-3 rounded text-center h-100">
                        <p>Note : 5 sur 5</p>
                        <blockquote>"Le menu de Noël était parfait, tout le monde s'est régalé. Livraison à l'heure."</blockquote>
                        <p class="mb-0">Claire M.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="vg-avis p-3 rounded text-center h-100">
                        <p>Note : 5 sur 5</p>
                        <blockquote>"Julie et José ont confectionné notre repas de mariage. Des plats généreux et faits maison."</blockquote>
                        <p class="mb-0">Karim et Léa</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="vg-avis p-3 rounded text-center h-100">
                        <p>Note : 4 sur 5</p>
                        <blockquote>"Très bon menu végétarien, même les plus carnivores ont aimé."</blockquote>
                        <p class="mb-0">Thomas R.</p>
                    </div>
                </div>              
            </div>
        </div>
    </section>

    <section id="equipe" class="py-5">
        <div class="container-fluid vg-container">
            <h2 class="text-center mb-4">Notre équipe</h2>
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    {# valeurs W et H viennent de squoosh = garde les proportions d'origine #}
                    <img src="{{ asset('images/equipe.webp') }}" alt="Cuisiniers en train de dresser des assiettes en cuisine" width="1400" height="933" class="img-fluid rounded">
                </div>
                <div class="col-lg-6 text-center">
                    <p>Depuis 25 ans, Julie et José mettent leur savoir-faire au service de vos fêtes. Produits frais, menus de saison et livraison soignée dans toute la région bordelaise.</p>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="vg-chiffre p-3 h-100">
                                <p><span class="fs-3 fw-bold">25 ans</span><br>d'expérience</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="vg-chiffre p-3 h-100">
                                <p><span class="fs-3 fw-bold">100%</span><br>fait maison</p>
                            </div>
                        </div>
                    
                    </div>
                </div>
            </div>
           
        </div>
        
    </section>
{% endblock %}
